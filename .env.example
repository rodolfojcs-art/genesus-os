# ============================================================
# GENESUS OS — Variables de entorno (apps/server)
# Copiar a .env — NUNCA commitear el .env real.
# Las llaves viven SOLO en el servidor. El frontend no las ve.
# ============================================================

# --- Anthropic (solo server) ---
ANTHROPIC_API_KEY=sk-ant-...

# Overrides opcionales de routing (defaults en packages/core/src/routing.ts)
GENESUS_MODEL_OPUS=claude-opus-4-8
GENESUS_MODEL_SONNET=claude-sonnet-4-6
GENESUS_MODEL_HAIKU=claude-haiku-4-5

# --- Supabase ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...          # service_role — solo server
SUPABASE_JWT_SECRET=...              # para validar JWT de usuarios
# Cadena Postgres directa (pg-boss). Si falta, se usa cola en memoria (solo dev).
DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

# --- Frontend (apps/web, prefijo VITE_) ---
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...        # anon key (publica, con RLS)
VITE_API_URL=http://localhost:8787

# --- Guardarraíles de costo ---
BUDGET_DAILY_USD=25
MAX_CONCURRENT_AGENTS=8
MAX_RECURSION_DEPTH=3
AUTO_APPROVE_UNDER_USD=0             # 0 = siempre requiere aprobación manual

# --- Orquestación externa ---
N8N_WEBHOOK_URL=                     # webhook saliente de misión completada (opcional)
EVOLUTION_API_URL=                   # WhatsApp via Evolution API (opcional)
EVOLUTION_API_KEY=

# --- Server ---
PORT=8787
HOST=0.0.0.0
RATE_LIMIT_PER_MINUTE=60
